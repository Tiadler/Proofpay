PORT=3000
# Optional local/self-hosted JSON store path. Do not set DATA_DIR=data on Vercel.
DATA_DIR=
# Recommended for Vercel persistence. Use Vercel KV or Upstash Redis REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional equivalent names when using Upstash directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PROOFPAY_STORE_KEY=proofpay:state
# Optional. Set true only if you want serverless remote storage to seed from bundled data/proofpay.json.
SEED_BUNDLED_DATA=false
# Optional. Without this, public GitHub API calls still work but rate limits are lower.
GITHUB_TOKEN=
# Optional production path. Configure these to enable real GitHub OAuth/App install flow.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
# Mock devnet settings. Replace later with a real Rialo CDK/RPC service.
RIALO_RPC_URL=
RIALO_MODE=mock
